# Copy to apps/api/.env and fill in. Never commit the real values.

# Postgres. On Neon use the pooled host ("-pooler") here...
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# ...and the direct host (no "-pooler") here, for migrations.
# For the local docker-compose database, use the same URL for both:
# postgresql://postgres:1400@localhost:5432/postgres
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Must be the same value as NEXTAUTH_SECRET in the Next.js apps:
# the web apps sign session tokens with it and the API verifies them.
JWT_SECRET="generate-with: openssl rand -base64 32"

# Stripe (test mode keys start with sk_test_)
STRIPE_SECRET_KEY="sk_test_..."
# Stripe sends the customer here after paying; the API creates the booking.
STRIPE_SUCCESS_URL="https://YOUR-API-HOST/stripe/success?session_id={CHECKOUT_SESSION_ID}"
# ...and here if they cancel.
STRIPE_CANCEL_URL="https://YOUR-WEB-HOST/booking-failed"
# Where the API sends the customer once the booking is saved.
BOOKINGS_REDIRECT_URL="https://YOUR-WEB-HOST/bookings"

# Set automatically by most hosts.
# PORT=3000
